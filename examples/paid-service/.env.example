# The account that is paid. Keep the real key out of the repository.
ARL_SERVICE_KEY=
# Where validators fetch spec.json (a public https:// or ipfs:// link to this exact file).
ARL_SPEC_URL=
# Price per call in ARL. Validators take a job only when the budget is at least their bond (100 ARL).
ARL_PRICE=100
# Optional: your own Base Mainnet endpoint, the validators to name, the port.
# ARL_RPC=https://mainnet.base.org
# ARL_COMMITTEE=0x...,0x...,0x...
# PORT=8787
